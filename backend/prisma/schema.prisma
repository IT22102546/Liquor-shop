generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum PosAdminRole {
  ADMIN
  CASHIER
  INVENTORY_MANAGER
  ACCOUNTANT
}

enum PosPurchaseItemType {
  INVENTORY
  CUSTOM
}

enum PosPurchaseMode {
  SINGLE
  BULK
}

enum PosPaymentType {
  DIRECT
  DOWNPAYMENT
}

enum PosSettlementStatus {
  SETTLED
  TO_SETTLE
}

enum PosPurchaseChannel {
  PERSONAL
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
}

enum AccountType {
  BANK
  CASH
}

enum AccountLevel {
  MAIN
  SUB
}

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  CARD
}

enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED
}

enum VoucherType {
  BILL
  OTHER_PAYMENT
  PERMIT
  LOAN_PAYMENT
  SALARY
  CUSTOMER_REFUND
  ADVANCE_REFUND
  ACCOUNT_TRANSFER
}

enum TransactionType {
  RECEIPT
  VOUCHER
  REVERSAL
  DEPOSIT
  TRANSFER
}

enum TransactionDirection {
  DR
  CR
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model PosAdmin {
  id           Int              @id @default(autoincrement())
  name         String
  email        String           @unique
  passwordHash String
  role         PosAdminRole     @default(ADMIN)
  isActive     Boolean          @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  counterSales PosCounterSale[]

  @@map("pos_admins")
}

model PosCounterSale {
  id               Int           @id @default(autoincrement())
  invoiceGroupCode String        @unique
  totalAmount      Float
  /// Total deducted for empty bottles returned (already subtracted from totalAmount).
  emptyDeduction   Float         @default(0)
  emptiesReturned  Int           @default(0)
  amountReceived   Float
  changeGiven      Float
  paymentMethod    PaymentMethod @default(CASH)
  /// Card approval code (from the card machine slip) or bank transfer / QR reference.
  paymentReference String?
  cashierId        Int
  cashier          PosAdmin      @relation(fields: [cashierId], references: [id])
  /// Loyalty member the sale was made to; null = walk-in customer.
  customerId       Int?
  customer         PosCustomer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  pointsEarned     Int           @default(0)
  /// Bill discount: "PERCENT" or "AMOUNT" (null = none), the value entered and the rupees taken off.
  discountType     String?
  discountValue    Float         @default(0)
  discountAmount   Float         @default(0)
  /// Loyalty points spent on this bill (1 point = Rs. 1) and their rupee value.
  pointsRedeemed   Int           @default(0)
  pointsValue      Float         @default(0)
  /// Shift (till session) the sale was made in; null for sales made before shifts existed.
  shiftId          Int?
  shift            PosShift?     @relation(fields: [shiftId], references: [id])
  createdAt        DateTime      @default(now())

  @@index([cashierId])
  @@index([customerId])
  @@index([shiftId])
  @@index([createdAt])
  @@map("pos_counter_sales")
}

// ── Suppliers ──────────────────────────────────────────────────────

model Supplier {
  id                Int                @id @default(autoincrement())
  name              String
  code              String             @unique
  contactPerson     String?
  telephone         String?
  address           String?
  fax               String?
  email             String?
  vatRegistrationNo String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  products          InventoryProduct[]

  @@map("suppliers")
}

model InventoryBrand {
  id        Int                @id @default(autoincrement())
  name      String             @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  products  InventoryProduct[]

  @@map("inventory_brands")
}

model InventoryCategory {
  id        Int                @id @default(autoincrement())
  name      String             @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  products  InventoryProduct[]

  @@map("inventory_categories")
}

model InventoryProduct {
  id                 Int                       @id @default(autoincrement())
  displayId          String                    @unique
  brandId            Int
  categoryId         Int
  supplierId         Int?
  brand              InventoryBrand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category           InventoryCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  supplier           Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name               String
  partNumber         String?
  compatibleWith     String?
  quantity           Int                       @default(0)
  soldQuantity       Int                       @default(0)
  lowStockThreshold  Int?
  purchasePrice      Float?
  taxPaid            Float?
  additionalExpenses Float?
  sellingPrice       Float?
  /// Deducted per empty bottle a customer hands back at the counter (null = not returnable).
  emptyBottlePrice   Float?
  /// Empty bottles collected at the counter and not yet returned to the supplier.
  emptyBottlesOnHand Int                       @default(0)
  description        String?
  lastSoldAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  expenses           InventoryProductExpense[]
  images             InventoryProductImage[]
  customerPurchases  PosCustomerPurchase[]

  @@index([brandId])
  @@index([categoryId])
  @@index([supplierId])
  @@map("inventory_products")
}

model InventoryProductExpense {
  id          Int              @id @default(autoincrement())
  productId   Int
  product     InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  createdAt   DateTime         @default(now())

  @@map("inventory_product_expenses")
}

model InventoryProductImage {
  id        Int              @id @default(autoincrement())
  productId Int
  product   InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean          @default(false)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  @@map("inventory_product_images")
}

/// Loyalty member (or the shared "Walk-in Customer" record, NIC "WALK-IN").
/// Only name and mobile are required; the rest is optional.
model PosCustomer {
  id            Int                   @id @default(autoincrement())
  firstName     String
  lastName      String
  nic           String?               @unique
  mobileNumber  String                @unique
  email         String?               @unique
  province      String?
  district      String?
  address       String?
  /// Loyalty: points balance, lifetime spend and visit count (updated on each counter sale).
  loyaltyPoints Int                   @default(0)
  totalSpent    Float                 @default(0)
  visits        Int                   @default(0)
  lastVisitAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  purchases     PosCustomerPurchase[]
  counterSales  PosCounterSale[]

  @@index([firstName])
  @@index([lastName])
  @@index([province])
  @@index([district])
  @@map("pos_customers")
}

model PosCustomerPurchase {
  id                       Int                 @id @default(autoincrement())
  customerId               Int
  itemType                 PosPurchaseItemType @default(INVENTORY)
  purchaseMode             PosPurchaseMode     @default(SINGLE)
  invoiceGroupCode         String?
  inventoryProductId       Int?
  customCategory           String?
  customDescription        String?
  currentSellingPrice      Float?
  finalSellingPrice        Float
  paymentType              PosPaymentType      @default(DIRECT)
  downPaymentAmount        Float               @default(0)
  remainingAmount          Float               @default(0)
  settlementStatus         PosSettlementStatus @default(SETTLED)
  purchaseChannel          PosPurchaseChannel  @default(PERSONAL)
  extraCosts               Json                @default("[]")
  interestRate             Float?
  installmentMonths        Int?
  monthlyInstallmentAmount Float?
  totalWithInterest        Float?
  quantity                 Int                 @default(1)
  /// Empty bottles handed back on this line and the amount deducted for them.
  emptiesReturned          Int                 @default(0)
  emptyDeduction           Float               @default(0)
  /// This line's share of the bill discount and redeemed points (already taken off finalSellingPrice).
  billDiscount             Float               @default(0)
  purchasedAt              DateTime            @default(now())
  customer                 PosCustomer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  inventoryProduct         InventoryProduct?   @relation(fields: [inventoryProductId], references: [id], onDelete: SetNull)
  receipts                 AccountReceipt[]
  installments             PosInstallment[]
  invoicePayments          InvoicePayment[]

  @@index([customerId])
  @@index([invoiceGroupCode])
  @@index([inventoryProductId])
  @@index([purchaseChannel])
  @@map("pos_customer_purchases")
}

enum InvoiceTermType {
  ADVANCE
  FINAL
}

model PosInvoiceTerm {
  id        Int             @id @default(autoincrement())
  text      String
  termType  InvoiceTermType @default(FINAL)
  sortOrder Int             @default(1)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([sortOrder])
  @@index([termType, sortOrder])
  @@map("pos_invoice_terms")
}

model PosInstallment {
  id            Int                     @id @default(autoincrement())
  purchaseId    Int
  installmentNo Int
  dueDate       DateTime
  dueAmount     Float
  paidAmount    Float                   @default(0)
  isPartial     Boolean                 @default(false)
  penaltyRate   Float                   @default(0)
  penaltyAmount Float                   @default(0)
  status        InstallmentStatus       @default(PENDING)
  settledAt     DateTime?
  notes         String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  purchase      PosCustomerPurchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  payments      PosInstallmentPayment[]

  @@index([purchaseId])
  @@map("pos_installments")
}

model PosInstallmentPayment {
  id            Int            @id @default(autoincrement())
  installmentId Int
  amount        Float
  penaltyAmount Float          @default(0)
  note          String?
  paidAt        DateTime       @default(now())
  installment   PosInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([installmentId])
  @@map("pos_installment_payments")
}

// ── Contact Requests ──────────────────────────────────────────────────────────

model ContactRequest {
  id        Int      @id @default(autoincrement())
  displayId String   @unique
  name      String
  email     String
  phone     String?
  city      String?
  interests String   @default("")
  message   String?
  status    String   @default("new")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("contact_requests")
}

// ── Accounts Module ───────────────────────────────────────────────────────────

model Account {
  id             Int                   @id @default(autoincrement())
  name           String
  code           String                @unique
  type           AccountType           @default(BANK)
  level          AccountLevel          @default(MAIN)
  openingBalance Float                 @default(0)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  receipts       AccountReceipt[]
  vouchers       AccountVoucher[]      @relation("VoucherFromAccount")
  toVouchers     AccountVoucher[]      @relation("VoucherToAccount")
  transactions   AccountTransaction[]
  deposits       AccountDeposit[]      @relation("MainAccountDeposits")
  subDeposits    AccountDeposit[]      @relation("SubAccountDeposits")
  mainLinks      AccountRelationship[] @relation("MainAccountLinks")
  subLinks       AccountRelationship[] @relation("SubAccountLinks")

  @@map("accounts")
}

model AccountRelationship {
  mainAccountId Int
  subAccountId  Int
  createdAt     DateTime @default(now())
  mainAccount   Account  @relation("MainAccountLinks", fields: [mainAccountId], references: [id], onDelete: Cascade)
  subAccount    Account  @relation("SubAccountLinks", fields: [subAccountId], references: [id], onDelete: Cascade)

  @@id([mainAccountId, subAccountId])
  @@index([subAccountId])
  @@map("account_relationships")
}

model AccountReceipt {
  id             Int                  @id @default(autoincrement())
  receiptNo      String               @unique
  purchaseId     Int
  accountId      Int?
  amount         Float
  paymentMethod  PaymentMethod        @default(CASH)
  chequeNo       String?
  chequeBank     String?
  chequeDate     DateTime?
  chequeStatus   ChequeStatus?
  description    String?
  isVoided       Boolean              @default(false)
  isDeposited    Boolean              @default(false)
  createdById    Int
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  account        Account?             @relation(fields: [accountId], references: [id])
  purchase       PosCustomerPurchase  @relation(fields: [purchaseId], references: [id])
  transactions   AccountTransaction[]
  depositItem    AccountDepositItem?
  invoicePayment InvoicePayment?      @relation("InvoicePaymentReceipt")

  @@index([purchaseId])
  @@index([accountId])
  @@map("account_receipts")
}

model AccountVoucher {
  id           Int                  @id @default(autoincrement())
  voucherNo    String               @unique
  accountId    Int
  toAccountId  Int?
  type         VoucherType
  amount       Float
  description  String?
  payee        String?
  paymentDate  DateTime?
  referenceNo  String?
  isVoided     Boolean              @default(false)
  createdById  Int
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  account      Account              @relation("VoucherFromAccount", fields: [accountId], references: [id])
  toAccount    Account?             @relation("VoucherToAccount", fields: [toAccountId], references: [id])
  transactions AccountTransaction[]

  @@index([accountId])
  @@index([toAccountId])
  @@map("account_vouchers")
}

model AccountTransaction {
  id          Int                  @id @default(autoincrement())
  accountId   Int
  type        TransactionType
  direction   TransactionDirection
  amount      Float
  receiptId   Int?
  voucherId   Int?
  depositId   Int?
  refNo       String?
  description String?
  chequeNo    String?
  isReversal  Boolean              @default(false)
  createdById Int
  createdAt   DateTime             @default(now())
  account     Account              @relation(fields: [accountId], references: [id])
  receipt     AccountReceipt?      @relation(fields: [receiptId], references: [id])
  voucher     AccountVoucher?      @relation(fields: [voucherId], references: [id])
  deposit     AccountDeposit?      @relation(fields: [depositId], references: [id])

  @@index([accountId])
  @@index([receiptId])
  @@index([voucherId])
  @@index([depositId])
  @@map("account_transactions")
}

model InvoicePayment {
  id            Int                 @id @default(autoincrement())
  purchaseId    Int
  amount        Float
  paymentMethod PaymentMethod       @default(CASH)
  chequeNo      String?
  chequeBank    String?
  chequeDate    DateTime?
  description   String?
  paidAt        DateTime            @default(now())
  receiptId     Int?                @unique
  purchase      PosCustomerPurchase @relation(fields: [purchaseId], references: [id])
  receipt       AccountReceipt?     @relation("InvoicePaymentReceipt", fields: [receiptId], references: [id])

  @@index([purchaseId])
  @@map("invoice_payments")
}

model AccountDeposit {
  id           Int                  @id @default(autoincrement())
  depositNo    String               @unique
  accountId    Int
  subAccountId Int?
  totalAmount  Float
  notes        String?
  isReversed   Boolean              @default(false)
  reversedAt   DateTime?
  createdById  Int
  createdAt    DateTime             @default(now())
  account      Account              @relation("MainAccountDeposits", fields: [accountId], references: [id])
  subAccount   Account?             @relation("SubAccountDeposits", fields: [subAccountId], references: [id])
  items        AccountDepositItem[]
  transactions AccountTransaction[]

  @@index([accountId])
  @@index([subAccountId])
  @@map("account_deposits")
}

model AccountDepositItem {
  id        Int            @id @default(autoincrement())
  depositId Int
  receiptId Int            @unique
  amount    Float
  deposit   AccountDeposit @relation(fields: [depositId], references: [id])
  receipt   AccountReceipt @relation(fields: [receiptId], references: [id])

  @@index([depositId])
  @@map("account_deposit_items")
}

// ── Activity Log ──────────────────────────────────────────────────────────────
// Append-only audit trail: sign-ins and every change saved through the POS API.
// Actor name/email/role are snapshotted so entries stay readable if staff change later.

model ActivityLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actorName  String?
  actorEmail String?
  actorRole  String?
  /// Machine-readable action, e.g. "auth.login", "sale.checkout", "product.update".
  action     String
  /// Filter group: AUTH, SALE, STOCK, PRODUCT, STAFF, ACCOUNTS, CUSTOMER, OTHER.
  category   String
  summary    String
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([category])
  @@map("activity_logs")
}

// ── Shop settings ─────────────────────────────────────────────────────────────
// Feature switches the admin can turn on/off (e.g. discounts, loyalty redemption).

model PosSetting {
  key         String   @id
  value       Json
  updatedById Int?
  updatedAt   DateTime @updatedAt

  @@map("pos_settings")
}

// ── Book balancing: shifts, cash book, stock movements ──────────────────────

/// A till session: opened with a float, closed with a blind cash count and a locked Z report.
model PosShift {
  id                 Int              @id @default(autoincrement())
  shiftNo            String           @unique
  status             String           @default("OPEN") // OPEN | CLOSED
  openedById         Int
  openedAt           DateTime         @default(now())
  openingFloat       Float
  /// Blind count: saved before the expected amount is shown.
  countedCash        Float?
  denominations      Json?
  countedById        Int?
  countedAt          DateTime?
  expectedCash       Float?
  cashDifference     Float?
  differenceReason   String?
  cardSlipTotal      Float?
  /// Why the card machine settlement didn't match the card sales (or "not settled yet").
  cardDifferenceReason String?
  floatLeft          Float?
  cashBanked         Float?
  closedById         Int?
  closedAt           DateTime?
  notes              String?
  /// Frozen Z report figures at close.
  report             Json?
  sales              PosCounterSale[]
  cashEntries        PosCashEntry[]
  movements          InventoryMovement[]

  @@index([status])
  @@index([openedAt])
  @@map("pos_shifts")
}

/// Cash book entry: money in (receipt, RCP-) or money out (voucher/expense, VCH-).
model PosCashEntry {
  id          Int       @id @default(autoincrement())
  entryNo     String    @unique
  direction   String    // IN | OUT
  category    String
  amount      Float
  /// Where the money came from / went: DRAWER (till), BANK or OWNER. Shift-close entries start in
  /// SAFE (cash takings) or CARD (card company) and move to BANK when marked as banked.
  source      String
  party       String?   // paid to / received from
  reference   String?
  note        String?
  entryDate   DateTime  @default(now())
  shiftId     Int?
  shift       PosShift? @relation(fields: [shiftId], references: [id])
  /// True for entries the system creates at shift close (takings banked, card settlement).
  automatic   Boolean   @default(false)
  createdById Int
  createdAt   DateTime  @default(now())
  voided      Boolean   @default(false)
  voidReason  String?
  voidedById  Int?
  voidedAt    DateTime?
  /// Takings waiting to be banked have bankStatus PENDING; BANKED once the deposit is confirmed.
  bankStatus    String?
  bankedAt      DateTime?
  bankedById    Int?
  bankReference String?

  @@index([direction, entryDate])
  @@index([bankStatus])
  @@index([shiftId])
  @@map("pos_cash_entries")
}

/// Every change to a product's stock or empties, for the stock day book.
model InventoryMovement {
  id          Int       @id @default(autoincrement())
  productId   Int
  /// STOCK (bottles for sale) or EMPTIES (empty bottles on hand).
  kind        String
  /// OPENING | RECEIVED | SOLD | ADJUSTED | COLLECTED | RETURNED
  type        String
  /// Signed change in units.
  quantity    Int
  shiftId     Int?
  shift       PosShift? @relation(fields: [shiftId], references: [id])
  reference   String?
  createdById Int?
  createdAt   DateTime  @default(now())

  @@index([productId, createdAt])
  @@index([shiftId])
  @@map("inventory_movements")
}
